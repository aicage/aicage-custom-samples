#!/usr/bin/env sh
set -eu

workspace="${AICAGE_WORKSPACE:-/workspace}"

echo "== aicage monitor =="
echo "time: $(date -Iseconds)"
echo "host: $(hostname)"
echo "workspace: ${workspace}"
echo

echo "== load and memory =="
uptime
free -h
echo

echo "== disk usage =="
df -h /
if [ -d "${workspace}" ]; then
  df -h "${workspace}" || true
fi
echo

echo "== cpu hot processes =="
ps -eo pid,ppid,user,%cpu,%mem,rss,etime,comm --sort=-%cpu | head -n 15
echo

echo "== memory hot processes =="
ps -eo pid,ppid,user,%cpu,%mem,rss,etime,comm --sort=-rss | head -n 15
echo

echo "== open files summary =="
lsof 2>/dev/null | awk 'NR==1 { next } { count[$1]++ } END { for (name in count) printf "%7d %s\n", count[name], name }' | sort -rn | head -n 10 || true
echo

echo "== network sockets =="
ss -tupan || true
